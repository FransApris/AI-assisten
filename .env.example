# RAG Knowledge Base - APRIS
# ============================================================
# Untuk Railway Production:
#   - Semua variabel ini diset via Railway Dashboard > Variables
#   - JANGAN commit file .env ke GitHub!
# ============================================================

# Google Gemini API (WAJIB diisi di Railway Dashboard)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ChromaDB - Path penyimpanan vector
# Di Railway: gunakan /data/vectorstore (Railway Volume)
# Di lokal  : gunakan ./vectorstore
CHROMA_DB_PATH=./vectorstore
CHROMA_COLLECTION_NAME=apris_knowledge

# Folder dokumen PDF
# Di Railway: gunakan /data/docs (Railway Volume)
# Di lokal  : gunakan ./docs
DOCS_FOLDER=./docs

# Server (Railway otomatis set PORT, tidak perlu diubah)
RAG_SERVER_PORT=5050
RAG_SERVER_HOST=0.0.0.0

# Jumlah hasil relevan saat query
TOP_K_RESULTS=5

# Chunk settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Environment: local / production
ENVIRONMENT=local
